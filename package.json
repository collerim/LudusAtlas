{
  "name": "ludusatlas",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first personal game library, activity tracker, achievements hub, and completion compass.",
  "license": "MIT",
  "author": "LudusAtlas contributors; based on PlayCounter by zntr1",
  "homepage": "https://github.com/collerim/LudusAtlas",
  "repository": {
    "type": "git",
    "url": "https://github.com/collerim/LudusAtlas.git"
  },
  "bugs": {
    "url": "https://github.com/collerim/LudusAtlas/issues"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@babel/core@>=7 <7.29.6": "^7.29.6",
      "browserslist@>=4 <4.28.7": "^4.28.7",
      "postcss-selector-parser@>=6 <6.1.3": "^6.1.3"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "check:fork-boundaries": "node scripts/ci/check-fork-boundaries.mjs",
    "desktop:version": "node scripts/ci/sync-desktop-version.mjs",
    "desktop:dev": "scripts\\dev-desktop.cmd",
    "desktop:build": "scripts\\build-desktop.cmd",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3"
  }
}
