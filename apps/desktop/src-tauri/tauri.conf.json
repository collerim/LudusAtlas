{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LudusAtlas",
  "version": "0.1.0",
  "identifier": "app.ludusatlas.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "beforeBuildCommand": "corepack pnpm build:prod",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LudusAtlas",
        "width": 1460,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "visible": false,
        "backgroundColor": "#0f1014"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
